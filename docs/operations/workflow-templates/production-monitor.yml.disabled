name: Production availability monitor

on:
  schedule:
    - cron: '17 * * * *'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: aiio-production-monitor
  cancel-in-progress: true

jobs:
  verify-production:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Check public routes and security headers
        shell: bash
        run: |
          set -euo pipefail
          BASE='https://aiio-canada.vercel.app'
          failed=0
          for route in / /scenario /evidence /digest /status /api/availability /api/health; do
            code="$(curl --silent --show-error --location --retry 3 --max-time 20 -o response.json -w '%{http_code}' "${BASE}${route}")" || code=000
            echo "route=${route} status=${code}"
            if [ "$code" != 200 ]; then
              echo "::error::Availability failure route=${route} status=${code}"
              if [ "$route" = /api/health ]; then cat response.json; fi
              failed=1
            fi
          done
          if [ "$failed" = 1 ]; then exit 1; fi
          headers="$(curl --fail --silent --show-error --head "${BASE}/")"
          grep -qi '^x-content-type-options: nosniff' <<<"$headers"
          grep -qi '^x-frame-options: DENY' <<<"$headers"

      - name: Verify machine-readable health contract
        shell: bash
        run: |
          set -euo pipefail
          curl --fail --silent --show-error --retry 3 --max-time 20 'https://aiio-canada.vercel.app/api/health' -o health.json
          python3 - <<'PY'
          import json
          with open('health.json', encoding='utf-8') as handle:
              health = json.load(handle)
          assert health['status'] == 'operational', health
          assert health['availability'] == 'available', health
          if health['readiness'] != 'ready':
              print('::warning::Evidence readiness degraded: ' + ', '.join(health['readiness_reasons']))
          print(json.dumps({'route': '/api/health', 'availability': health['availability'], 'readiness': health['readiness'], 'reasons': health['readiness_reasons'], 'source_freshness': health['evidence']['source_freshness']}, sort_keys=True))
          assert health['evidence']['artifact_count'] >= 1, health
          assert health['release']['forecast_authorized'] is False, health
          PY

      - name: Retain health diagnostics
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: production-health-diagnostics
          path: |
            health.json
            response.json
          if-no-files-found: ignore
